---
// A steam train, the Orient Express, running through the banner as the country rolls past, drawn live as
// newspaper halftone dots. It waits left of center; the whistle sends it surging right, then it drifts back.
// A nod to Agatha Christie: Murder on the Orient Express, and the A.B.C. railway guide in The A.B.C. Murders.
// A click blows the whistle. The mouse parts the smoke. The scene follows the time of day where I am:
//   Dawn (5–7):   the Milk Train. The sun rises on the left, the last stars fade, mist lies on the hills.
//   Day (7–17):   the Express. A sun, drifting clouds, telegraph poles along the line, and a flock of
//                 birds that scatters at the whistle.
//   Dusk (17–19): the Evening Express. The sun sets on the right, the sky darkens from the top and the
//                 first stars come out, the windows, lamps and headlamp come on, and the birds fly home.
//   Night (19–5): the Night Mail. A moon and stars, lit windows, a headlamp beam on the rail ahead,
//                 sparks from the chimney (a burst of them at the whistle), and now and then a shooting star.
import { site } from '../site';
---
<!-- The train's name and the hint sit in a caption under the banner, in the page's own colors, so they
     read the same in every scene and theme. -->
<figure class="train">
  <button type="button" class="hero" aria-label="Blow the train whistle" data-tz={site.timeZone}>
    <canvas aria-hidden="true"></canvas>
  </button>
  <figcaption class="hero-caption" aria-hidden="true">
    <span class="hero-label">The B<i>.</i>C<i>.</i>A<i>.</i> <span class="by-dawn">Milk Train</span><span class="by-day">Express</span><span class="by-dusk">Evening Express</span><span class="by-night">Night Mail</span> <i>·</i> <time class="hero-time"></time></span>
    <span class="hero-hint">Pull the whistle</span>
  </figcaption>
</figure>

<script>
  const hero = document.querySelector<HTMLButtonElement>('.hero')!;
  const canvas = hero.querySelector('canvas')!;
  const ctx = canvas.getContext('2d')!;
  const INK = '#2a2620';
  const PAPER = '#efe8d4';
  let CELL = 6; // distance between dots, in CSS pixels; finer on a short (phone) banner, so the train keeps its shape
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

  let W = 0, H = 0, s = 1, rail = 0;

  // The phase of the day where I am (the footer clock's time zone). ?dawn, ?day, ?dusk or ?night forces
  // one, for testing.
  type Phase = 'dawn' | 'day' | 'dusk' | 'night';
  let phase: Phase = 'day', night = false, dusk = false, dawn = false;
  const phaseNow = (): Phase => {
    const forced = location.search.match(/[?&](dawn|day|dusk|night)\b/)?.[1] as Phase | undefined;
    if (forced) return forced;
    const hour = Number(new Intl.DateTimeFormat('en-US', { timeZone: hero.dataset.tz, hour: 'numeric', hourCycle: 'h23' }).format(new Date()));
    return hour >= 19 || hour < 5 ? 'night' : hour < 7 ? 'dawn' : hour < 17 ? 'day' : 'dusk';
  };
  const setPhase = () => {
    phase = phaseNow(); night = phase === 'night'; dusk = phase === 'dusk'; dawn = phase === 'dawn';
    for (const p of ['dawn', 'dusk', 'night']) hero.classList.toggle(p, phase === p);
  };
  setPhase();

  // The mouse, in canvas pixels, while it is over the banner. The smoke clears around it.
  let mouse: { x: number; y: number } | null = null;
  const smooth = (u: number) => u * u * (3 - 2 * u);

  // Value noise, for billowing smoke and uneven ground.
  const hash = (x: number, y: number) => {
    let h = Math.imul(x, 374761393) + Math.imul(y, 668265263);
    h = Math.imul(h ^ (h >>> 13), 1274126177);
    return ((h ^ (h >>> 16)) >>> 0) / 4294967295;
  };
  const noise = (x: number, y: number) => {
    const xi = Math.floor(x), yi = Math.floor(y), xf = x - xi, yf = y - yi;
    const u = xf * xf * (3 - 2 * xf), v = yf * yf * (3 - 2 * yf);
    const a = hash(xi, yi), b = hash(xi + 1, yi), c = hash(xi, yi + 1), d = hash(xi + 1, yi + 1);
    return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v;
  };

  // The train, in its own units: x runs left from the front buffer (0), y runs up from the rail (0).
  // Later shapes paint over earlier ones, so windows sit on top of bodies. d is ink darkness, 0 to 1.
  // win marks a window: clear paper at night, so it looks lit.
  type Shape = { r?: [number, number, number, number]; c?: [number, number, number]; d: number; wheel?: boolean; win?: boolean };
  const shapes: Shape[] = [];
  const rect = (x0: number, x1: number, y0: number, y1: number, d: number, win = false) => shapes.push({ r: [x0, x1, y0, y1], d, win });
  const circ = (cx: number, cy: number, r: number, d: number, wheel = false) => shapes.push({ c: [cx, cy, r], d, wheel });
  // The vehicles' spans, front to rear, so each body can rock on its own.
  const vehicles: [number, number][] = [];
  // Wagons-Lits cars, 1930s style, as on the Orient Express: a rounded roof, a pale band under it where
  // the gold lettering runs, a long row of tall windows (some with the blind half down), a door at each
  // end, two four-wheel bogies, and bellows (the covered gangway) to the next car. The middle one is the
  // dining car, with wider windows.
  const L = 132, GAP = 8;
  for (let i = 0; i < 3; i++) {
    const x = -254 - (i + 1) * L - i * GAP, x1 = x + L;
    vehicles.push([x - GAP, x1]);
    rect(x1, x1 + GAP, -60, -22, 0.7); // bellows to the car in front
    rect(x, x1, -64, -18, 0.82); // body
    rect(x + 2, x1 - 2, -69, -64, 0.95); rect(x + 10, x1 - 10, -72, -69, 0.95); // rounded roof
    rect(x + 12, x1 - 12, -62, -58, 0.3); // the lettering band
    rect(x + 3, x + 10, -56, -20, 0.95); rect(x1 - 10, x1 - 3, -56, -20, 0.95); // end doors
    if (i === 1) for (let k = 0; k < 4; k++) rect(x + 15 + k * 27, x + 36 + k * 27, -54, -36, 0.22, true); // dining car
    else for (let k = 0; k < 6; k++) {
      const wx = x + 14 + k * 18;
      rect(wx, wx + 12, -54, -36, 0.22, true);
      if ((k + i) % 3 === 1) rect(wx, wx + 12, -54, -46, 0.6); // a blind half down
    }
    for (const b of [x + 8, x1 - 40]) { // bogies
      rect(b, b + 32, -15, -10, 0.95);
      circ(b + 7, -7, 7, 0.95, true); circ(b + 25, -7, 7, 0.95, true);
    }
  }
  // Tender with a heap of coal, on two bogies.
  vehicles.push([-254, -180]);
  rect(-254, -246, -30, -26, 0.9); // coupling
  rect(-246, -184, -60, -18, 0.86); circ(-215, -58, 14, 0.95);
  for (const b of [-240, -206]) { rect(b, b + 26, -15, -10, 0.95); circ(b + 6, -7, 7, 0.97, true); circ(b + 20, -7, 7, 0.97, true); }
  // The engine: a big European express engine (a Pacific). A long boiler, a roomy cab, three tall driving
  // wheels, a small bogie in front, and smoke deflectors (the tall plates beside the smokebox).
  vehicles.push([-180, 6]);
  rect(-180, -132, -82, -20, 0.9); rect(-184, -128, -88, -82, 0.98); // cab and its roof
  rect(-172, -148, -74, -58, 0.25, true); // cab window
  rect(-134, -12, -54, -22, 0.8); circ(-12, -38, 16, 0.9); // boiler and smokebox
  circ(-76, -55, 7, 0.95); rect(-104, -98, -60, -54, 0.95); // dome and safety valve
  rect(-31, -19, -72, -50, 0.95); rect(-34, -16, -76, -70, 1); // chimney
  rect(-48, -8, -62, -24, 0.97); // smoke deflector
  rect(-180, 4, -24, -18, 0.98); // running board
  rect(-1, 6, -60, -52, 0.95, true); // headlamp: lit at night, and the beam starts here
  circ(-122, -15, 15, 0.97, true); circ(-89, -15, 15, 0.97, true); circ(-56, -15, 15, 0.97, true); // driving wheels
  rect(-122, -56, -17, -13, 0.95); // the coupling rod between them
  circ(-27, -7, 7, 0.97, true); circ(-9, -7, 7, 0.97, true); circ(-158, -9, 9, 0.97, true);
  const TRAIN_LEN = 254 + 3 * L + 2 * GAP;

  // The train's place on the screen. It waits left of center, with its tail off the left edge.
  let tx = 0, restX = 0, fwdX = 0; // screen x of the front buffer, its resting mark, and how far ahead it may run
  let ox = 0; // how far the camera has travelled, so how far the ground has rolled past, in CSS pixels
  let cam = 0; // the camera's speed over the ground, in CSS pixels a second
  // Each layer rolls past at its own speed, which is what reads as depth and travel: the far hills at
  // 0.15x the ground, a row of firs at 0.5x, the track and poles at 1x, a fence near the eye at 2x.
  // The hills have a ragged treeline on top, so their edge shows the movement.
  const hillsAt = (x: number) => {
    const hx = x + ox * 0.15;
    return H * 0.6 + (noise(hx * 0.012, 4.2) - 0.5) * H * 0.22 - Math.max(0, noise(hx * 0.05, 1.3) - 0.45) * H * 0.12;
  };
  type Puff = { x: number; y: number; age: number; life: number; r0: number };
  let puffs: Puff[] = [];
  let t = 0;
  // The engine chuffs four times per turn of the driving wheels (radius 15), so the puffs keep time with them.
  const CHUFF = (2 * Math.PI * 15) / 4;
  let nextChuff = 0;
  // Each car rocks up for a moment as its wheels cross a rail joint: the engine first, then each car behind it.
  const JOINT = 60; // a joint every 60 train units of rail
  const bob = vehicles.map(() => 0);
  // How far the train has run over the ground, in CSS pixels: the ground rolling past, plus its own lurches.
  const run = () => ox + tx;

  // Day: a flock of five birds in a loose V crosses the sky every few seconds. The whistle scatters it.
  // Sizes are in CSS pixels, not train units, so the birds stay a few dots wide on the halftone screen.
  type Bird = { x: number; y: number; vx: number; vy: number; phase: number };
  let birds: Bird[] = [], nextFlock = 2;
  // At dusk the flock flies the other way, home toward the sunset.
  const flock = () => {
    const y0 = H * (0.14 + Math.random() * 0.1), dir = dusk ? 1 : -1;
    birds = [0, 1, -1, 2, -2].map((k) => ({
      x: dir < 0 ? W + 40 + Math.abs(k) * 26 : -40 - Math.abs(k) * 26, y: y0 + k * 9 + Math.random() * 4,
      vx: (dir * W) / 20, vy: 0, phase: Math.random() * 6,
    }));
  };
  const scatter = () => {
    const cx = tx - 25 * s;
    for (const b of birds) {
      b.vx = Math.sign(b.x - cx || 1) * (70 + Math.random() * 90);
      b.vy = -(70 + Math.random() * 90);
    }
  };

  // Night: sparks (glowing embers) from the chimney, and now and then a shooting star.
  type Spark = { x: number; y: number; vx: number; vy: number; age: number; life: number };
  let sparks: Spark[] = [];
  const spark = (speed: number) => sparks.push({
    x: tx - 25 * s + (Math.random() - 0.5) * 8 * s, y: rail - 78 * s,
    vx: -(10 + Math.random() * 40) * speed + (Math.random() - 0.5) * 40 * speed, vy: -(40 + Math.random() * 60) * speed,
    age: 0, life: 0.8 + Math.random() * 0.9,
  });
  type Star = { x: number; y: number; vx: number; vy: number; age: number };
  let star: Star | null = null, nextStar = 6;

  const resize = () => {
    const box = canvas.getBoundingClientRect();
    const dpr = Math.min(2, devicePixelRatio || 1);
    W = box.width; H = box.height;
    canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    s = H / 235; rail = H * 0.82; CELL = Math.max(4.5, Math.min(6, H / 35));
    restX = Math.max(200 * s, W * 0.58); fwdX = Math.max(restX, W - 12 * s);
    if (!tx || calm) tx = restX;
  };

  const train = (x: number, y: number) => {
    const lx = (x - tx) / s, ly = (y - rail) / s;
    if (lx < -TRAIN_LEN || lx > 6 || ly < -95 || ly > 1) return -1;
    // The bodies rock on their springs; the wheels stay on the rail.
    let k = vehicles.length - 1;
    while (k > 0 && lx < vehicles[k][0]) k--;
    const lb = (y + bob[k] - rail) / s;
    let d = -1;
    for (const p of shapes) {
      if (p.r) {
        const [x0, x1, y0, y1] = p.r;
        if (lx >= x0 && lx <= x1 && lb >= y0 && lb <= y1) d = p.win && (night || dusk) ? 0 : p.d; // lamps lit from dusk
      } else if (p.c) {
        const [cx, cy, r] = p.c, dx = lx - cx, dy = (p.wheel ? ly : lb) - cy, dist = Math.hypot(dx, dy);
        if (dist <= r) {
          if (!p.wheel) d = p.d;
          else {
            // A dark rim with turning spokes.
            const spoke = Math.abs(Math.sin(Math.atan2(dy, dx) * 3 + run() / (r * s)));
            d = dist > r - 3 || spoke < 0.25 || dist < 2.5 ? p.d : 0.35;
          }
        }
      }
    }
    return d;
  };

  // Telegraph poles along the line, every 170 train units, each with two crossbars and two
  // wires that sag between poles. Lines a few pixels thick come out as dotted lines on the screen.
  const poles = (sx: number, y: number) => {
    const x = sx + ox;
    const gap = 170 * s, top = rail - 112 * s;
    if (y < top - 2 || y > rail - 3 * s) return 0;
    const i = Math.floor((x - gap * 0.3) / gap), px = gap * 0.3 + i * gap, u = (x - px) / gap;
    const near = Math.min(x - px, px + gap - x); // distance to the nearest pole
    if (near < 2.2 * s) return 0.85; // the pole
    for (const [bar, half] of [[6, 14], [17, 10]]) {
      const by = top + bar * s;
      if (near < half * s && Math.abs(y - by) < 1.8 * s) return 0.85; // a crossbar
      if (Math.abs(y - (by + 16 * s * 4 * u * (1 - u))) < 2.2) return 0.7; // its wire, sagging to the next pole
    }
    return 0;
  };

  // A row of firs in the middle distance, at half the ground speed, with gaps. They stand behind the track.
  const trees = (x: number, y: number) => {
    const mx = x + ox * 0.5, gap = 70 * s, i = Math.floor(mx / gap), base = rail - 8 * s;
    if (y > base || hash(i, 3) < 0.4) return 0;
    const cx = (i + 0.3 + hash(i, 5) * 0.4) * gap, h = (34 + hash(i, 7) * 26) * s, top = base - h, dx = Math.abs(mx - cx);
    if (y < top) return 0;
    if (y > base - 6 * s) return dx < 2.5 * s ? 1 : 0; // the trunk
    return dx < (y - top) * 0.3 ? 1 : 0; // the crown, widening toward the ground
  };

  // Now and then a cottage among the firs, at the same half speed. Its two windows are lit from dusk.
  // The windows are at least two dots wide, so they never fall between dots on a phone. 0: none, 1: wall or roof, 2: window.
  const cottage = (x: number, y: number) => {
    const mx = x + ox * 0.5, gap = 260 * s, i = Math.floor(mx / gap), base = rail - 8 * s;
    if (y > base || hash(i, 13) < 0.5) return 0;
    const cx = (i + 0.5) * gap, dx = Math.abs(mx - cx), wall = base - 22 * s, roof = wall - 14 * s;
    if (y < roof || dx > 26 * s) return 0;
    if (y < wall) return dx < 26 * s * (y - roof) / (14 * s) ? 1 : 0; // the roof
    if (dx > 20 * s) return 0;
    const win = Math.max(7 * s, CELL * 1.8), wy = wall + 9 * s;
    return Math.abs(dx - 10 * s) < win / 2 && Math.abs(y - wy) < win / 2 ? 2 : 1;
  };

  // From dusk, lamp posts along the line at the track's speed: a clear lamp with a soft halo round it.
  // Returns the post's darkness, -1 off the post, and in halo the factor that lightens what is behind.
  let halo = 1;
  const lamp = (x: number, y: number) => {
    halo = 1;
    if (!(night || dusk)) return -1;
    const gap = 300 * s, px = (Math.round((x + ox) / gap - 0.65) + 0.65) * gap - ox, top = rail - 82 * s;
    const head = Math.max(4 * s, CELL * 0.9), dist = Math.hypot(x - px, y - top), R = 30 * s;
    if (dist < head) return 0;
    if (dist < head + CELL * 0.7) return 0.9; // the lantern's dark frame, so it shows against a pale sky too
    if (Math.abs(x - px) < Math.max(1.6 * s, CELL * 0.4) && y > top && y < rail) return 0.85;
    if (dist < R) halo = 0.3 + 0.7 * smooth(dist / R);
    return -1;
  };

  // Fence posts close to the eye, at twice the ground speed, passing in front of the wheels. Sizes are in
  // dot cells, not train units, so the posts stay solid and never alias with the halftone screen.
  const fence = (x: number, y: number) => {
    if (y < rail - 24 * s) return 0;
    const fx = x + ox * 2, gap = 26 * CELL, i = Math.floor(fx / gap);
    return Math.abs(fx - (i + 0.2 + 0.6 * hash(i, 11)) * gap) < CELL * 1.1 ? 0.95 : 0; // spaced not quite evenly
  };

  const scene = (x: number, y: number) => {
    const l = lamp(x, y);
    return l >= 0 ? l : landscape(x, y) * halo;
  };

  const landscape = (x: number, y: number) => {
    const hills = hillsAt(x), gx = x + ox, hx = x + ox * 0.15; // ground and hill x, rolling past
    // The track, in dot cells: a sleeper every 4 cells, and a rail at least one dot row thick.
    const railHalf = Math.max(1.6 * s, CELL * 0.45), sleeper = y > rail && y < rail + Math.max(6 * s, CELL * 1.8) && gx % (4 * CELL) < 1.5 * CELL;
    // Poles and firs: dark against the day and dusk sky, moonlit (light) against the night hills.
    const house = cottage(x, y);
    if (house) return house === 2 ? (night || dusk ? 0 : 0.85) : night ? 0.75 : dawn ? 0.35 : dusk ? 0.8 : 0.5;
    const pole = poles(x, y), tree = pole ? 0 : trees(x, y);
    if (pole || tree) return night ? 0.12 : pole || (dawn ? 0.3 : dusk ? 0.68 : 0.4); // firs paler than the train, as they are farther off
    if (night) {
      if (y < hills) {
        if (star) { // a shooting star: a clear streak, brightest at its head, fading along its tail
          const sp = Math.hypot(star.vx, star.vy), ux = star.vx / sp, uy = star.vy / sp;
          const bx = star.x - x, by = star.y - y, back = bx * ux + by * uy;
          if (back >= 0 && back < 90 && Math.abs(bx * uy - by * ux) < 2.6) return 0.9 * (back / 90);
        }
        // A paper moon: a clear disc, with an inked disc over one side for the crescent.
        const mx = W * 0.84, my = H * 0.26, mr = H * 0.1;
        if (Math.hypot(x - mx, y - my) < mr) return Math.hypot(x - mx + mr * 0.5, y - my + mr * 0.15) < mr * 0.9 ? 0.9 : 0;
        if (hash(Math.floor(x), Math.floor(y)) > 0.992) return 0; // stars
        const u = y / hills;
        return 0.9 - 0.62 * u * u; // inked sky, lighter toward the hills so the train still shows
      }
      if (y < rail - 6 * s) return 0.45 + 0.06 * noise(hx * 0.05, y * 0.05); // dark hills under the glow of the horizon
      if (Math.abs(y - rail) < railHalf) return 0.1; // moonlight on the rail
      if (sleeper) return 0.85;
      return 0.5 + 0.1 * noise(gx * 0.08, y * 0.08);
    }
    if (y < hills) {
      for (const b of birds) { // a bird: two wings in a shallow V that beat up and down
        const dx = x - b.x;
        if (Math.abs(dx) > 15 || Math.abs(y - b.y) > 12) continue;
        const tip = 7 * Math.sin(b.phase);
        if (Math.abs(y - (b.y - (Math.abs(dx) / 15) * tip)) < 2.6) return 0.9;
      }
      // A few light clouds drift slowly left, in a band below the lettering and above the hills.
      const band = y / H;
      if (band > 0.14 && band < 0.46) {
        const fade = Math.min(1, (band - 0.14) / 0.08, (0.46 - band) / 0.1);
        const c = noise((x + t * 7 + ox * 0.08) * 0.0065, y * 0.03 + 7.3) * fade;
        if (c > 0.6) return Math.min(0.24, (c - 0.6) * 1.8 + 0.06);
      }
      if (dawn || dusk) {
        // A low sun on the horizon: rising on the left at dawn, half set on the right at dusk. The hills
        // hide its lower part, since it is drawn only above them.
        const sx = W * (dusk ? 0.78 : 0.18), sy = H * (dusk ? 0.58 : 0.53), sr = H * 0.14, sd = Math.hypot(x - sx, y - sy);
        if (sd < sr) return sd > sr - 4 ? 0.75 : 0.22;
        if (sd > sr * 1.25 && sd < sr * 2.3 && Math.abs(Math.sin(Math.atan2(y - sy, x - sx) * 7)) > 0.9) return 0.45;
        // The sky inks from the top: deep at dusk with the first stars out, pale at dawn with the last ones.
        const u = 1 - y / hills, sky = dusk ? 0.12 + 0.62 * u * u : 0.04 + 0.2 * u * u * u;
        if (sky > (dusk ? 0.3 : 0.18) && hash(Math.floor(x), Math.floor(y)) > (dusk ? 0.994 : 0.997)) return 0;
        return sky;
      }
      // The sun: a light disc with an inked rim, and short rays.
      const sx = W * 0.84, sy = H * 0.26, sr = H * 0.09, sd = Math.hypot(x - sx, y - sy);
      if (sd < sr) return sd > sr - 4 ? 0.7 : 0.32;
      if (sd > sr * 1.3 && sd < sr * 1.9 && Math.abs(Math.sin(Math.atan2(y - sy, x - sx) * 6)) > 0.9) return 0.5;
      return Math.max(0, (y / H - 0.25)) * 0.12; // blank paper at the top, a light haze near the hills
    }
    if (y < rail - 6 * s) {
      if (dawn) return 0.07 + 0.07 * noise((hx - t * 6) * 0.025, y * 0.06); // morning mist drifting over the hills
      if (dusk) return 0.5 + 0.06 * noise(hx * 0.05, y * 0.05); // hills in silhouette against the sky
      return 0.2 + 0.08 * noise(hx * 0.05, y * 0.05);
    }
    if (Math.abs(y - rail) < railHalf) return 0.95; // the rail
    if (sleeper) return 0.75;
    return 0.42 + 0.12 * noise(gx * 0.08, y * 0.08); // embankment
  };

  const smoke = (x: number, y: number) => {
    let sum = 0;
    for (const p of puffs) {
      const r = p.r0 + p.age * 13 * s;
      const dx = x - p.x, dy = y - p.y, q = (dx * dx + dy * dy) / (r * r);
      if (q > 2.5) continue;
      const dens = Math.pow(1 - p.age / p.life, 1.8) * 0.5;
      sum += dens * Math.exp(-q * 1.4);
    }
    if (sum <= 0.01) return 0;
    let v = Math.min(0.85, sum * (0.3 + 0.9 * noise(x * 0.05 + t * 0.2, y * 0.05 - t * 0.35)));
    if (mouse) { // a clear patch around the mouse, soft at the edge
      const md = Math.hypot(x - mouse.x, y - mouse.y);
      if (md < 45) v *= smooth(md / 45);
    }
    return v;
  };

  // The whistle: a big burst of steam, and the engine puts on speed. It is real motion, as if filmed from a
  // car beside the line (a chase camera):
  //   - The train's speed over the ground rises smoothly to about 7x cruise, holds, then eases back.
  //   - While it speeds up, the camera keeps its cruising speed, so the train runs ahead to the right.
  //   - Then the camera gives chase (a critically damped spring on the gap), so the scenery rushes past
  //     faster for a moment and the train settles back to its mark, about a second after its peak.
  // The wheels, chuffs and smoke follow the train's own speed, which never drops below cruise, and the
  // camera never slows below cruise either, so nothing ever runs backward.
  const RISE = 0.15, HOLD = 0.35, FALL = 0.6; // seconds
  const LURCH = 2.1; // the extra speed at the peak, in run-ahead distances a second
  const CHASE = 9; // the camera's spring, 1/s²: higher catches up faster
  let since = -1; // seconds since the whistle, while the burst lasts; -1 when cruising
  const burst = () => // how far into the burst the engine is, 0 to 1
    since < 0 ? 0 : since < RISE ? 0.5 - 0.5 * Math.cos((Math.PI * since) / RISE) : since < RISE + HOLD ? 1
      : since < RISE + HOLD + FALL ? 0.5 + 0.5 * Math.cos((Math.PI * (since - RISE - HOLD)) / FALL) : 0;
  const whistle = () => {
    // A second pull keeps the speed up: start the rise from wherever the burst is now, never back at zero.
    const b = burst();
    since = b >= 1 ? Math.min(since, RISE) : (RISE * Math.acos(1 - 2 * b)) / Math.PI;
    if (!night) scatter();
    if (night) for (let i = 0; i < 28; i++) spark(1.8); // a shower of sparks with the steam
    const cx = tx - 25 * s, cy = rail - 78 * s;
    for (let i = 0; i < 12; i++) {
      puffs.push({ x: cx + (Math.random() - 0.5) * 14 * s, y: cy - i * 3 * s, age: Math.random() * 0.3, life: 5 + Math.random() * 1.5, r0: (9 + Math.random() * 6) * s });
    }
  };

  const step = (dt: number) => {
    t += dt;
    const cruise = 100 * s;
    const V = cruise + LURCH * (fwdX - restX) * burst(); // the train's speed over the ground
    if (since >= 0 && (since += dt) > RISE + HOLD + FALL) since = -1;
    if (!cam || calm) cam = V; // in the reduced-motion still, the camera keeps pace and the train stays put
    else {
      const k = since >= 0 && since < RISE + HOLD ? 0 : CHASE; // the camera holds its speed until the engine eases off
      cam += (k * (tx - restX) + 2 * Math.sqrt(k) * (V - cam)) * dt;
      tx += (V - cam) * dt;
    }
    ox += cam * dt;
    const v = cam; // the ground's speed across the screen
    const surge = V / cruise; // how hard the train drives through the air
    if (run() / s >= nextChuff) { // a chuff: a strong puff from the chimney, and a weaker one just after
      nextChuff = run() / s + CHUFF;
      for (const k of [1, 0.6]) puffs.push({ x: tx - 25 * s + (Math.random() - 0.5) * 4 * s, y: rail - 78 * s - (1 - k) * 6 * s, age: 0, life: 4.5 + Math.random(), r0: 8 * k * s });
    }
    // A short lift of a dot or two as a car crosses a joint, eased in and out.
    for (let k = 0; k < vehicles.length; k++) {
      const u = (((run() / s + (vehicles[k][0] + vehicles[k][1]) / 2) % JOINT) + JOINT) % JOINT / JOINT;
      bob[k] = u < 0.18 ? Math.sin((u / 0.18) * Math.PI) * Math.max(1.5, CELL * 0.35) : 0;
    }
    // The smoke hangs in the air as the train pulls away, and lies flatter the faster it goes.
    for (const p of puffs) { p.age += dt; p.y -= ((20 - p.age * 3) * s * dt) / surge; p.x -= (v + 9 * s) * dt; }
    if (mouse) { // the mouse pushes nearby puffs aside, like a hand waving through steam
      for (const p of puffs) {
        const dx = p.x - mouse.x, dy = p.y - mouse.y, d = Math.hypot(dx, dy) || 1;
        if (d < 70) { const k = (1 - d / 70) * 60 * dt; p.x += (dx / d) * k; p.y += (dy / d) * k; }
      }
    }
    puffs = puffs.filter((p) => p.age < p.life);

    if (night) {
      birds = [];
      // A steady trickle of sparks while the chimney is in view, falling back as they cool.
      if (Math.random() < dt * 6) spark(1);
      for (const k of sparks) { k.age += dt; k.vy += 60 * dt; k.x += (k.vx - v) * dt; k.y += k.vy * dt; }
      sparks = sparks.filter((k) => k.age < k.life);
      // A shooting star every 7 to 16 seconds, gone in under a second. Not in the reduced-motion still.
      if (star) {
        star.age += dt; star.x += star.vx * dt; star.y += star.vy * dt;
        if (star.age > 0.9) { star = null; nextStar = 7 + Math.random() * 9; }
      } else if (!calm && (nextStar -= dt) <= 0) {
        star = { x: W * (0.1 + Math.random() * 0.4), y: H * (0.06 + Math.random() * 0.12), vx: W * 0.8, vy: H * 0.3, age: 0 };
      }
    } else {
      sparks = []; star = null;
      if (birds.length) {
        for (const b of birds) {
          const flying = b.vy < 0; // scattered birds beat their wings faster
          b.phase += dt * (flying ? 18 : 8); b.x += b.vx * dt; b.y += b.vy * dt;
        }
        birds = birds.filter((b) => b.x > -200 && b.x < W + 200 && b.y > -30);
        if (!birds.length) nextFlock = 5 + Math.random() * 6;
      } else if ((nextFlock -= dt) <= 0) flock();
    }
  };

  const draw = () => {
    ctx.fillStyle = PAPER; ctx.fillRect(0, 0, W, H);
    ctx.fillStyle = INK; ctx.beginPath();
    const lampX = tx + 6 * s, lampY = rail - 56 * s; // where the headlamp beam starts
    const rowH = CELL * 0.866; // offset rows: dots sit on a 60° screen, like a printed halftone
    for (let j = 0, y = rowH / 2; y < H + CELL; j++, y += rowH) {
      for (let x = (j % 2) * CELL / 2; x < W + CELL; x += CELL) {
        let d = fence(x, y);
        if (!d) { const base = train(x, y); d = base >= 0 ? base : scene(x, y); }
        if ((night || dusk) && x > lampX) { // the headlamp beam: a cone that fans down onto the rail ahead, fading with distance
          const dx = x - lampX, slope = (y - lampY) / dx, reach = W * 0.5;
          if (dx < reach && slope > -0.06 && slope < 0.42) {
            const edge = Math.min(1, Math.min(slope + 0.06, 0.42 - slope) / 0.08);
            d *= 1 - (night ? 0.85 : 0.5) * (1 - dx / reach) * edge; // fainter at dusk, while there is still light
          }
        }
        const sm = smoke(x, y);
        d = night ? d * (1 - sm) : d + sm * (1 - d); // by day smoke is ink; by night, steam lit by the moon
        for (const k of sparks) { // sparks glow: clear paper, shrinking as they cool
          const kx = x - k.x, ky = y - k.y;
          if (Math.abs(kx) < 5 && Math.abs(ky) < 5 && kx * kx + ky * ky < (4.5 * (1 - 0.5 * k.age / k.life)) ** 2) d = 0;
        }
        const r = CELL * 0.6 * Math.sqrt(d);
        if (d < 0.04) continue; // leave clean paper
        ctx.moveTo(x + r, y); ctx.arc(x, y, r, 0, Math.PI * 2);
      }
    }
    ctx.fill();
    flag();
  };

  // A small Philippine flag on a staff on the cab roof, for where I am. It is the one spot of color on the
  // print, drawn sharp over the dots, and it streams back in the wind with a ripple that grows toward the
  // free end. The flag is 1:2, with an equilateral white triangle at the staff holding a gold sun and three
  // gold stars. It rides with the engine as it rocks.
  const flag = () => {
    const b = bob[vehicles.length - 1], X0 = -130, LEN = 20, HT = 10, TOP = -106;
    const P = (u: number, v: number) => [
      tx + (X0 - LEN * u) * s,
      rail + (TOP + HT * v + Math.sin(t * 10 - u * 6) * 1.4 * u) * s - b,
    ];
    const shape = (pts: number[][], color: string) => {
      ctx.fillStyle = color; ctx.beginPath();
      pts.forEach(([u, v], i) => { const [x, y] = P(u, v); i ? ctx.lineTo(x, y) : ctx.moveTo(x, y); });
      ctx.fill();
    };
    const band = (v0: number, v1: number) => [...Array(9).keys()].map((i) => [i / 8, v0]).concat([...Array(9).keys()].map((i) => [(8 - i) / 8, v1]));
    const dot = (u: number, v: number, r: number) => { const [x, y] = P(u, v); ctx.moveTo(x + r * s, y); ctx.arc(x, y, r * s, 0, Math.PI * 2); };
    ctx.strokeStyle = INK; ctx.lineWidth = Math.max(1.2, 1.3 * s); ctx.beginPath(); // the staff
    ctx.moveTo(tx + X0 * s, rail - 88 * s - b); ctx.lineTo(tx + X0 * s, rail + (TOP - 1) * s - b); ctx.stroke();
    shape(band(0, 0.5), '#0038a8'); // blue above
    shape(band(0.5, 1), '#ce1126'); // red below
    const tip = (0.866 * HT) / LEN;
    shape([[0, 0], [tip, 0.5], [0, 1]], '#fbf8ee'); // the white triangle
    ctx.fillStyle = '#fcd116'; ctx.beginPath();
    dot(tip / 3, 0.5, 1.6); // the sun
    dot(0.035, 0.12, 0.7); dot(0.035, 0.88, 0.7); dot(tip - 0.05, 0.5, 0.7); // the stars
    ctx.fill();
  };

  resize();
  new ResizeObserver(() => { resize(); draw(); }).observe(canvas);
  // The live time where I am, railway style (24-hour), beside the train's name.
  const clock = document.querySelector<HTMLTimeElement>('.hero-time')!;
  const hhmm = new Intl.DateTimeFormat('en-GB', { timeZone: hero.dataset.tz, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
  const tick = () => {
    clock.textContent = hhmm.format(new Date());
    const was = phase; setPhase(); if (was !== phase) draw();
  };
  tick();
  setInterval(tick, 1000);

  canvas.addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse') return;
    const b = canvas.getBoundingClientRect();
    mouse = { x: e.clientX - b.left, y: e.clientY - b.top };
    if (calm) draw();
  });
  canvas.addEventListener('pointerleave', () => { mouse = null; if (calm) draw(); });

  if (calm) {
    // A still frame: the train with its smoke trail behind it.
    for (let i = 0; i < 180; i++) step(1 / 30);
    draw();
    // The whistle still works, as a new still frame with the burst of steam.
    hero.addEventListener('click', () => {
      whistle();
      for (let i = 0; i < 20; i++) step(1 / 30);
      draw();
    });
  } else {
    hero.addEventListener('click', whistle);
    for (let i = 0; i < 90; i++) step(1 / 30); // start with smoke already in the air
    let visible = true, last = 0, raf = 0;
    const loop = (now: number) => {
      raf = 0;
      if (!visible || document.hidden) return;
      const dt = Math.min(0.1, (now - (last || now)) / 1000);
      if (now - last >= 33) { last = now; step(dt || 1 / 30); draw(); } // about 30 frames a second
      raf = requestAnimationFrame(loop);
    };
    const start = () => { if (!raf) { last = 0; raf = requestAnimationFrame(loop); } };
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible) start(); }).observe(canvas);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) start(); });
    draw();
    start();
  }
</script>

<style>
  .train { margin: 0 0 28px; }
  .hero {
    position: relative; display: block; width: 100%; height: clamp(150px, 34vw, 210px); padding: 0; border: 0;
    border-radius: 2px; overflow: hidden; font: inherit; text-align: left;
    background: #efe8d4; box-shadow: 0 1px 0 var(--line), 0 8px 20px -14px rgb(0 0 0 / 0.5);
  }
  .hero:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  canvas { display: block; width: 100%; height: 100%; }
  /* The caption: the train's name on the left, the hint on the right, like a print's caption. */
  .hero-caption {
    display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-top: 8px;
    font: 10px var(--deco); letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted);
  }
  .hero-label i { font-style: normal; color: var(--accent); }
  .hero-caption { flex-wrap: wrap; row-gap: 4px; } /* on a phone the hint drops under the name, whole */
  .hero-label, .hero-hint { white-space: nowrap; }
  .hero-hint { margin-left: auto; }
  .hero-time { font-variant-numeric: tabular-nums; }
  /* The hint brightens while the banner is hovered or focused, so people know it does something. */
  .hero-hint { opacity: 0.7; transition: opacity 0.3s, color 0.3s; }
  .train:has(.hero:is(:hover, :focus-visible)) .hero-hint { opacity: 1; color: var(--accent); }
  /* The train's name for the time of day: the Milk Train, the Express, the Evening Express, the Night Mail.
     The script puts the phase class on the banner, so the caption reads it from there. */
  .by-dawn, .by-dusk, .by-night, .train:has(.hero:is(.dawn, .dusk, .night)) .by-day { display: none; }
  .train:has(.hero.dawn) .by-dawn, .train:has(.hero.dusk) .by-dusk, .train:has(.hero.night) .by-night { display: inline; }
</style>

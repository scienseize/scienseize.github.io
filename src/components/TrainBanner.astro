---
// A steam train crossing the banner, drawn live as newspaper halftone dots.
// A nod to the A.B.C. railway guide in The A.B.C. Murders.
// A click blows the whistle. The mouse parts the smoke. The scene follows the time of day where I am:
//   Dawn (5–7):   the Milk Train. The sun rises on the left, the last stars fade, mist lies on the hills.
//   Day (7–17):   the Express. A sun, drifting clouds, telegraph poles along the line, and a flock of
//                 birds that scatters at the whistle.
//   Dusk (17–19): the Evening Express. The sun sets on the right, the sky darkens from the top and the
//                 first stars come out, the windows and the headlamp come on, and the birds fly home.
//   Night (19–5): the Night Mail. A moon and stars, lit windows, a headlamp beam on the rail ahead,
//                 sparks from the chimney (a burst of them at the whistle), and now and then a shooting star.
import { site } from '../site';
---
<!-- The train's name and the hint sit in a caption under the banner, in the page's own colors, so they
     read the same in every scene and theme. -->
<figure class="train">
  <button type="button" class="hero" aria-label="Blow the train whistle" data-tz={site.timeZone}>
    <canvas aria-hidden="true"></canvas>
  </button>
  <figcaption class="hero-caption" aria-hidden="true">
    <span class="hero-label">The B<i>.</i>C<i>.</i>A<i>.</i> <span class="by-dawn">Milk Train</span><span class="by-day">Express</span><span class="by-dusk">Evening Express</span><span class="by-night">Night Mail</span></span>
    <span class="hero-hint">Pull the whistle</span>
  </figcaption>
</figure>

<script>
  const hero = document.querySelector<HTMLButtonElement>('.hero')!;
  const canvas = hero.querySelector('canvas')!;
  const ctx = canvas.getContext('2d')!;
  const INK = '#2a2620';
  const PAPER = '#efe8d4';
  const CELL = 6; // distance between dots, in CSS pixels
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

  let W = 0, H = 0, s = 1, rail = 0;

  // The phase of the day where I am (the footer clock's time zone). ?dawn, ?day, ?dusk or ?night forces
  // one, for testing.
  type Phase = 'dawn' | 'day' | 'dusk' | 'night';
  let phase: Phase = 'day', night = false, dusk = false, dawn = false;
  const phaseNow = (): Phase => {
    const forced = location.search.match(/[?&](dawn|day|dusk|night)\b/)?.[1] as Phase | undefined;
    if (forced) return forced;
    const hour = Number(new Intl.DateTimeFormat('en-US', { timeZone: hero.dataset.tz, hour: 'numeric', hourCycle: 'h23' }).format(new Date()));
    return hour >= 19 || hour < 5 ? 'night' : hour < 7 ? 'dawn' : hour < 17 ? 'day' : 'dusk';
  };
  const setPhase = () => {
    phase = phaseNow(); night = phase === 'night'; dusk = phase === 'dusk'; dawn = phase === 'dawn';
    for (const p of ['dawn', 'dusk', 'night']) hero.classList.toggle(p, phase === p);
  };
  setPhase();

  // The mouse, in canvas pixels, while it is over the banner. The smoke clears around it.
  let mouse: { x: number; y: number } | null = null;
  const smooth = (u: number) => u * u * (3 - 2 * u);

  // Value noise, for billowing smoke and uneven ground.
  const hash = (x: number, y: number) => {
    let h = Math.imul(x, 374761393) + Math.imul(y, 668265263);
    h = Math.imul(h ^ (h >>> 13), 1274126177);
    return ((h ^ (h >>> 16)) >>> 0) / 4294967295;
  };
  const noise = (x: number, y: number) => {
    const xi = Math.floor(x), yi = Math.floor(y), xf = x - xi, yf = y - yi;
    const u = xf * xf * (3 - 2 * xf), v = yf * yf * (3 - 2 * yf);
    const a = hash(xi, yi), b = hash(xi + 1, yi), c = hash(xi, yi + 1), d = hash(xi + 1, yi + 1);
    return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v;
  };

  // The train, in its own units: x runs left from the front buffer (0), y runs up from the rail (0).
  // Later shapes paint over earlier ones, so windows sit on top of bodies. d is ink darkness, 0 to 1.
  // win marks a window: clear paper at night, so it looks lit.
  type Shape = { r?: [number, number, number, number]; c?: [number, number, number]; d: number; wheel?: boolean; win?: boolean };
  const shapes: Shape[] = [];
  const rect = (x0: number, x1: number, y0: number, y1: number, d: number, win = false) => shapes.push({ r: [x0, x1, y0, y1], d, win });
  const circ = (cx: number, cy: number, r: number, d: number, wheel = false) => shapes.push({ c: [cx, cy, r], d, wheel });
  // Carriages, coupled behind the tender.
  for (const x of [-454, -344]) {
    rect(x, x + 102, -62, -18, 0.82); // body
    rect(x - 4, x + 106, -67, -62, 0.95); rect(x + 6, x + 96, -71, -67, 0.95); // roof with a clerestory
    for (let k = 0; k < 5; k++) rect(x + 8 + k * 19, x + 20 + k * 19, -54, -40, 0.22, true);
    rect(x + 102, x + 110, -30, -26, 0.9); // coupling
    circ(x + 18, -10, 9, 0.95, true); circ(x + 84, -10, 9, 0.95, true);
  }
  // Tender with a heap of coal.
  rect(-232, -162, -58, -18, 0.86); circ(-197, -56, 13, 0.95);
  rect(-162, -150, -30, -26, 0.9);
  circ(-215, -10, 9, 0.95, true); circ(-180, -10, 9, 0.95, true);
  // Locomotive: cab, boiler, dome, chimney, smokebox, running board.
  rect(-152, -112, -78, -20, 0.9); rect(-156, -108, -84, -78, 0.98);
  rect(-144, -124, -70, -56, 0.25, true); // cab window
  rect(-116, -10, -52, -20, 0.88); circ(-12, -36, 16, 0.92);
  circ(-62, -54, 8, 0.95);
  rect(-31, -19, -72, -50, 0.95); rect(-34, -16, -76, -70, 1);
  rect(-160, 4, -22, -14, 0.98);
  rect(-1, 6, -60, -52, 0.95, true); // headlamp: lit at night, and the beam starts here
  circ(-100, -12, 13, 0.97, true); circ(-71, -12, 13, 0.97, true); circ(-42, -12, 13, 0.97, true);
  circ(-17, -9, 8, 0.97, true); circ(-134, -10, 9, 0.97, true);
  const TRAIN_LEN = 460;

  let tx = 0; // world x of the front buffer
  type Puff = { x: number; y: number; age: number; life: number; r0: number };
  let puffs: Puff[] = [];
  let emit = 0, t = 0;

  // Day: a flock of five birds in a loose V crosses the sky every few seconds. The whistle scatters it.
  // Sizes are in CSS pixels, not train units, so the birds stay a few dots wide on the halftone screen.
  type Bird = { x: number; y: number; vx: number; vy: number; phase: number };
  let birds: Bird[] = [], nextFlock = 2;
  // At dusk the flock flies the other way, home toward the sunset.
  const flock = () => {
    const y0 = H * (0.14 + Math.random() * 0.1), dir = dusk ? 1 : -1;
    birds = [0, 1, -1, 2, -2].map((k) => ({
      x: dir < 0 ? W + 40 + Math.abs(k) * 26 : -40 - Math.abs(k) * 26, y: y0 + k * 9 + Math.random() * 4,
      vx: (dir * W) / 20, vy: 0, phase: Math.random() * 6,
    }));
  };
  const scatter = () => {
    const cx = tx - 25 * s;
    for (const b of birds) {
      b.vx = Math.sign(b.x - cx || 1) * (70 + Math.random() * 90);
      b.vy = -(70 + Math.random() * 90);
    }
  };

  // Night: sparks (glowing embers) from the chimney, and now and then a shooting star.
  type Spark = { x: number; y: number; vx: number; vy: number; age: number; life: number };
  let sparks: Spark[] = [];
  const spark = (speed: number) => sparks.push({
    x: tx - 25 * s + (Math.random() - 0.5) * 8 * s, y: rail - 78 * s,
    vx: -(10 + Math.random() * 40) * speed + (Math.random() - 0.5) * 40 * speed, vy: -(40 + Math.random() * 60) * speed,
    age: 0, life: 0.8 + Math.random() * 0.9,
  });
  type Star = { x: number; y: number; vx: number; vy: number; age: number };
  let star: Star | null = null, nextStar = 6;

  const resize = () => {
    const box = canvas.getBoundingClientRect();
    const dpr = Math.min(2, devicePixelRatio || 1);
    W = box.width; H = box.height;
    canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    s = H / 235; rail = H * 0.82;
  };

  const train = (x: number, y: number) => {
    const lx = (x - tx) / s, ly = (y - rail) / s;
    if (lx < -460 || lx > 6 || ly < -90 || ly > 1) return -1;
    let d = -1;
    for (const p of shapes) {
      if (p.r) {
        const [x0, x1, y0, y1] = p.r;
        if (lx >= x0 && lx <= x1 && ly >= y0 && ly <= y1) d = p.win && (night || dusk) ? 0 : p.d; // lamps lit from dusk
      } else if (p.c) {
        const [cx, cy, r] = p.c, dx = lx - cx, dy = ly - cy, dist = Math.hypot(dx, dy);
        if (dist <= r) {
          if (!p.wheel) d = p.d;
          else {
            // A dark rim with turning spokes.
            const spoke = Math.abs(Math.sin(Math.atan2(dy, dx) * 3 + tx / (r * s)));
            d = dist > r - 3 || spoke < 0.25 || dist < 2.5 ? p.d : 0.35;
          }
        }
      }
    }
    return d;
  };

  // Telegraph poles along the line (day only), every 170 train units, each with two crossbars and two
  // wires that sag between poles. Lines a few pixels thick come out as dotted lines on the screen.
  const poles = (x: number, y: number) => {
    const gap = 170 * s, top = rail - 112 * s;
    if (y < top - 2 || y > rail - 3 * s) return 0;
    const i = Math.floor((x - gap * 0.3) / gap), px = gap * 0.3 + i * gap, u = (x - px) / gap;
    const near = Math.min(x - px, px + gap - x); // distance to the nearest pole
    if (near < 2.2 * s) return 0.85; // the pole
    for (const [bar, half] of [[6, 14], [17, 10]]) {
      const by = top + bar * s;
      if (near < half * s && Math.abs(y - by) < 1.8 * s) return 0.85; // a crossbar
      if (Math.abs(y - (by + 16 * s * 4 * u * (1 - u))) < 2) return 0.7; // its wire, sagging to the next pole
    }
    return 0;
  };

  const scene = (x: number, y: number) => {
    const hills = H * 0.6 + (noise(x * 0.012, 4.2) - 0.5) * H * 0.22;
    if (night) {
      if (y < hills) {
        if (star) { // a shooting star: a clear streak, brightest at its head, fading along its tail
          const sp = Math.hypot(star.vx, star.vy), ux = star.vx / sp, uy = star.vy / sp;
          const bx = star.x - x, by = star.y - y, back = bx * ux + by * uy;
          if (back >= 0 && back < 90 && Math.abs(bx * uy - by * ux) < 2.6) return 0.9 * (back / 90);
        }
        // A paper moon: a clear disc, with an inked disc over one side for the crescent.
        const mx = W * 0.84, my = H * 0.26, mr = H * 0.1;
        if (Math.hypot(x - mx, y - my) < mr) return Math.hypot(x - mx + mr * 0.5, y - my + mr * 0.15) < mr * 0.9 ? 0.9 : 0;
        if (hash(Math.floor(x), Math.floor(y)) > 0.992) return 0; // stars
        const u = y / hills;
        return 0.9 - 0.62 * u * u; // inked sky, lighter toward the hills so the train still shows
      }
      if (y < rail - 6 * s) return 0.2 + 0.08 * noise(x * 0.05, y * 0.05); // moonlit hills
      if (Math.abs(y - rail) < 1.6 * s) return 0.1; // moonlight on the rail
      if (y > rail && y < rail + 6 * s && ((x + 1000) % (16 * s)) < 6 * s) return 0.85;
      return 0.5 + 0.1 * noise(x * 0.08, y * 0.08);
    }
    const pole = poles(x, y); // telegraph poles stand in front of the hills and sky, behind the train
    if (pole > 0) return pole;
    if (y < hills) {
      for (const b of birds) { // a bird: two wings in a shallow V that beat up and down
        const dx = x - b.x;
        if (Math.abs(dx) > 15 || Math.abs(y - b.y) > 12) continue;
        const tip = 7 * Math.sin(b.phase);
        if (Math.abs(y - (b.y - (Math.abs(dx) / 15) * tip)) < 2.6) return 0.9;
      }
      // A few light clouds drift slowly left, in a band below the lettering and above the hills.
      const band = y / H;
      if (band > 0.14 && band < 0.46) {
        const fade = Math.min(1, (band - 0.14) / 0.08, (0.46 - band) / 0.1);
        const c = noise((x + t * 7) * 0.0065, y * 0.03 + 7.3) * fade;
        if (c > 0.6) return Math.min(0.24, (c - 0.6) * 1.8 + 0.06);
      }
      if (dawn || dusk) {
        // A low sun on the horizon: rising on the left at dawn, half set on the right at dusk. The hills
        // hide its lower part, since it is drawn only above them.
        const sx = W * (dusk ? 0.78 : 0.18), horizon = H * 0.6 + (noise(sx * 0.012, 4.2) - 0.5) * H * 0.22;
        const sy = horizon - H * (dusk ? 0.02 : 0.07), sr = H * 0.14, sd = Math.hypot(x - sx, y - sy);
        if (sd < sr) return sd > sr - 4 ? 0.75 : 0.22;
        if (sd > sr * 1.25 && sd < sr * 2.3 && Math.abs(Math.sin(Math.atan2(y - sy, x - sx) * 7)) > 0.9) return 0.45;
        // The sky inks from the top: deep at dusk with the first stars out, pale at dawn with the last ones.
        const u = 1 - y / hills, sky = dusk ? 0.12 + 0.62 * u * u : 0.04 + 0.2 * u * u * u;
        if (sky > (dusk ? 0.3 : 0.18) && hash(Math.floor(x), Math.floor(y)) > (dusk ? 0.994 : 0.997)) return 0;
        return sky;
      }
      // The sun: a light disc with an inked rim, and short rays.
      const sx = W * 0.84, sy = H * 0.26, sr = H * 0.09, sd = Math.hypot(x - sx, y - sy);
      if (sd < sr) return sd > sr - 4 ? 0.7 : 0.32;
      if (sd > sr * 1.3 && sd < sr * 1.9 && Math.abs(Math.sin(Math.atan2(y - sy, x - sx) * 6)) > 0.9) return 0.5;
      return Math.max(0, (y / H - 0.25)) * 0.12; // blank paper at the top, a light haze near the hills
    }
    if (y < rail - 6 * s) {
      if (dawn) return 0.07 + 0.07 * noise((x - t * 6) * 0.025, y * 0.06); // morning mist drifting over the hills
      if (dusk) return 0.34 + 0.1 * noise(x * 0.05, y * 0.05); // hills going dark against the sky
      return 0.2 + 0.08 * noise(x * 0.05, y * 0.05);
    }
    if (Math.abs(y - rail) < 1.6 * s) return 0.95; // the rail
    if (y > rail && y < rail + 6 * s && ((x + 1000) % (16 * s)) < 6 * s) return 0.75; // sleepers
    return 0.42 + 0.12 * noise(x * 0.08, y * 0.08); // embankment
  };

  const smoke = (x: number, y: number) => {
    let sum = 0;
    for (const p of puffs) {
      const r = p.r0 + p.age * 13 * s;
      const dx = x - p.x, dy = y - p.y, q = (dx * dx + dy * dy) / (r * r);
      if (q > 2.5) continue;
      const dens = Math.pow(1 - p.age / p.life, 1.8) * 0.5;
      sum += dens * Math.exp(-q * 1.4);
    }
    if (sum <= 0.01) return 0;
    let v = Math.min(0.85, sum * (0.3 + 0.9 * noise(x * 0.05 + t * 0.2, y * 0.05 - t * 0.35)));
    if (mouse) { // a clear patch around the mouse, soft at the edge
      const md = Math.hypot(x - mouse.x, y - mouse.y);
      if (md < 45) v *= smooth(md / 45);
    }
    return v;
  };

  // The whistle: a big burst of steam from the chimney, and a surge of speed that eases off.
  // If the chimney is off-screen, the train races round and whistles as soon as the chimney is back in view.
  let boost = 0, pendingWhistle = false;
  const BOOST = 1.5; // seconds
  const chimneyOnScreen = () => tx - 25 * s > 10 && tx - 25 * s < W - 10;
  const whistle = () => {
    boost = BOOST;
    if (!night) scatter(); // the birds hear it at once, wherever the train is
    if (!chimneyOnScreen()) return void (pendingWhistle = true);
    if (night) for (let i = 0; i < 28; i++) spark(1.8); // a shower of sparks with the steam
    const cx = tx - 25 * s, cy = rail - 78 * s;
    for (let i = 0; i < 12; i++) {
      puffs.push({ x: cx + (Math.random() - 0.5) * 14 * s, y: cy - i * 3 * s, age: Math.random() * 0.3, life: 5 + Math.random() * 1.5, r0: (9 + Math.random() * 6) * s });
    }
  };

  const step = (dt: number) => {
    t += dt;
    if (pendingWhistle) boost = BOOST; // keep racing until the whistle can blow
    const surge = 1 + (1.2 * Math.max(0, boost)) / BOOST;
    boost -= dt;
    tx += (W / 16) * dt * surge; // about 16 s to cross
    if (tx > W + TRAIN_LEN * s + (pendingWhistle ? 0 : 120)) tx = -20;
    if (pendingWhistle && chimneyOnScreen()) { pendingWhistle = false; whistle(); }
    emit -= dt;
    if (emit <= 0 && tx > -10 && tx < W + 30) {
      emit = 0.11;
      puffs.push({ x: tx - 25 * s + (Math.random() - 0.5) * 4 * s, y: rail - 78 * s, age: 0, life: 4.5 + Math.random(), r0: 6 * s });
    }
    for (const p of puffs) { p.age += dt; p.y -= (20 - p.age * 3) * s * dt; p.x -= 9 * s * dt; }
    if (mouse) { // the mouse pushes nearby puffs aside, like a hand waving through steam
      for (const p of puffs) {
        const dx = p.x - mouse.x, dy = p.y - mouse.y, d = Math.hypot(dx, dy) || 1;
        if (d < 70) { const k = (1 - d / 70) * 60 * dt; p.x += (dx / d) * k; p.y += (dy / d) * k; }
      }
    }
    puffs = puffs.filter((p) => p.age < p.life);

    if (night) {
      birds = [];
      // A steady trickle of sparks while the chimney is in view, falling back as they cool.
      if (chimneyOnScreen() && Math.random() < dt * 6) spark(1);
      for (const k of sparks) { k.age += dt; k.vy += 60 * dt; k.x += k.vx * dt; k.y += k.vy * dt; }
      sparks = sparks.filter((k) => k.age < k.life);
      // A shooting star every 7 to 16 seconds, gone in under a second. Not in the reduced-motion still.
      if (star) {
        star.age += dt; star.x += star.vx * dt; star.y += star.vy * dt;
        if (star.age > 0.9) { star = null; nextStar = 7 + Math.random() * 9; }
      } else if (!calm && (nextStar -= dt) <= 0) {
        star = { x: W * (0.1 + Math.random() * 0.4), y: H * (0.06 + Math.random() * 0.12), vx: W * 0.8, vy: H * 0.3, age: 0 };
      }
    } else {
      sparks = []; star = null;
      if (birds.length) {
        for (const b of birds) {
          const flying = b.vy < 0; // scattered birds beat their wings faster
          b.phase += dt * (flying ? 18 : 8); b.x += b.vx * dt; b.y += b.vy * dt;
        }
        birds = birds.filter((b) => b.x > -200 && b.x < W + 200 && b.y > -30);
        if (!birds.length) nextFlock = 5 + Math.random() * 6;
      } else if ((nextFlock -= dt) <= 0) flock();
    }
  };

  const draw = () => {
    ctx.fillStyle = PAPER; ctx.fillRect(0, 0, W, H);
    ctx.fillStyle = INK; ctx.beginPath();
    const lampX = tx + 6 * s, lampY = rail - 56 * s; // where the headlamp beam starts
    const rowH = CELL * 0.866; // offset rows: dots sit on a 60° screen, like a printed halftone
    for (let j = 0, y = rowH / 2; y < H + CELL; j++, y += rowH) {
      for (let x = (j % 2) * CELL / 2; x < W + CELL; x += CELL) {
        const base = train(x, y);
        let d = base >= 0 ? base : scene(x, y);
        if ((night || dusk) && x > lampX) { // the headlamp beam: a cone that fans down onto the rail ahead, fading with distance
          const dx = x - lampX, slope = (y - lampY) / dx, reach = W * 0.5;
          if (dx < reach && slope > -0.06 && slope < 0.42) {
            const edge = Math.min(1, Math.min(slope + 0.06, 0.42 - slope) / 0.08);
            d *= 1 - (night ? 0.85 : 0.5) * (1 - dx / reach) * edge; // fainter at dusk, while there is still light
          }
        }
        const sm = smoke(x, y);
        d = night ? d * (1 - sm) : d + sm * (1 - d); // by day smoke is ink; by night, steam lit by the moon
        for (const k of sparks) { // sparks glow: clear paper, shrinking as they cool
          const kx = x - k.x, ky = y - k.y;
          if (Math.abs(kx) < 5 && Math.abs(ky) < 5 && kx * kx + ky * ky < (4.5 * (1 - 0.5 * k.age / k.life)) ** 2) d = 0;
        }
        const r = CELL * 0.6 * Math.sqrt(d);
        if (d < 0.04) continue; // leave clean paper
        ctx.moveTo(x + r, y); ctx.arc(x, y, r, 0, Math.PI * 2);
      }
    }
    ctx.fill();
  };

  resize();
  new ResizeObserver(() => { resize(); draw(); }).observe(canvas);
  setInterval(() => { const was = phase; setPhase(); if (was !== phase) draw(); }, 60_000);

  canvas.addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse') return;
    const b = canvas.getBoundingClientRect();
    mouse = { x: e.clientX - b.left, y: e.clientY - b.top };
    if (calm) draw();
  });
  canvas.addEventListener('pointerleave', () => { mouse = null; if (calm) draw(); });

  if (calm) {
    // A still frame: the train mid-banner with its smoke trail behind it.
    tx = W * 0.55 - 6 * (W / 16);
    for (let i = 0; i < 180; i++) step(1 / 30);
    draw();
    // The whistle still works, as a new still frame with the burst of steam.
    hero.addEventListener('click', () => {
      if (!chimneyOnScreen()) tx = W * 0.55; // no racing round in a still frame
      whistle();
      for (let i = 0; i < 20; i++) step(1 / 30);
      draw();
    });
  } else {
    hero.addEventListener('click', whistle);
    tx = W * 0.35;
    for (let i = 0; i < 90; i++) step(1 / 30); // start with smoke already in the air
    let visible = true, last = 0, raf = 0;
    const loop = (now: number) => {
      raf = 0;
      if (!visible || document.hidden) return;
      const dt = Math.min(0.1, (now - (last || now)) / 1000);
      if (now - last >= 33) { last = now; step(dt || 1 / 30); draw(); } // about 30 frames a second
      raf = requestAnimationFrame(loop);
    };
    const start = () => { if (!raf) { last = 0; raf = requestAnimationFrame(loop); } };
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible) start(); }).observe(canvas);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) start(); });
    draw();
    start();
  }
</script>

<style>
  .train { margin: 0 0 28px; }
  .hero {

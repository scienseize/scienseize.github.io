---
import Base from '../layouts/Base.astro';
import { Content } from '../about.md';
import { getCollection } from 'astro:content';
import { site, about, timeline, photos } from '../site';

// A Recognition entry with a project or event photos gets a small taped print. The print opens a
// case file on this page: the project's screenshot (or a title page for a paper), a short summary,
// and photos of the event.
const projects = new Map((await getCollection('projects')).map((p) => [p.id, p.data]));
type Entry = (typeof timeline)[number]['entries'][number];
const fileOf = (e: Entry) => {
  const p = e.project ? projects.get(e.project) : undefined;
  const shots = (e.photos ?? []).map((src) => ({ src, caption: photos.find((ph) => ph.image === src)?.caption ?? '' }));
  if (!p && !shots.length) return undefined;
  const shot = p && (p.cover ?? p.images[0]);
  return { title: p?.title ?? e.org, paper: p && !shot ? (e.paper ?? p.title) : undefined, shot, summary: p?.summary ?? p?.blurb, shots };
};
let fileCount = 0;
---
<Base title="About" description="About Bill C. Alcantara, an AI engineer in Manila: experience, leadership, awards, and life outside of code.">
  <h1>About</h1>

  <div class="card">
    <figure class="evidence">
      <div class="print">
        {about.photo ? <img src={about.photo} alt={`Portrait of ${site.name}`} /> : <div class="photo" />}
      </div>
      <figcaption class="namesake">
        {site.name.split(' ').map((w, i, all) => (
          <><b>{w[0]}</b>{w.slice(1).replace('.', '')}{(w.endsWith('.') || i === all.length - 1) && <i>.</i>}{i < all.length - 1 && ' '}</>
        ))}
      </figcaption>
      <svg class="pen" aria-hidden="true"></svg>
    </figure>
    <dl>
      {about.facts.map((f, i) => (<><dt class="label" style={`--i:${i}`}>{f.label}</dt><dd style={`--i:${i}`}>{f.value}</dd></>))}
      <dt class="label" style={`--i:${about.facts.length}`}>Contact</dt>
      <dd style={`--i:${about.facts.length}`}>
        {[{ label: 'Email', href: `mailto:${site.email}` }, ...site.socials.filter((s) => s.href)].map((s, i) => (
          <>{i > 0 && ' · '}<a href={s.href}>{s.label}</a></>
        ))}
      </dd>
    </dl>
    <svg class="strings" aria-hidden="true"></svg>
  </div>
  <script is:inline>
    // The booking reveal (see the styles) plays on every load, a reload too, but not when Back or Forward
    // returns to the page. It is set here, before the first paint, so the card never shows and then goes dark.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && performance.getEntriesByType('navigation')[0]?.type !== 'back_forward') {
      document.querySelector('.card').classList.add('booking');
    }
  </script>

  <div class="prose"><Content /></div>
  <figure class="peek-card" hidden aria-hidden="true"><img alt="" /><video muted loop playsinline preload="none" hidden></video><figcaption></figcaption></figure>

  {timeline.map((t) => {
    const thumbed = t.entries.some((e) => fileOf(e)); // keep text aligned across the section
    return (
      <section>
        <h2 class="label">{t.heading}</h2>
        {t.entries.map((e) => {
          const f = fileOf(e);
          const id = f && `file-${++fileCount}`;
          return (
            <div class:list={['entry', { thumbed }]}>
              {thumbed && (f
                ? <button type="button" class="clip" data-file={id} aria-haspopup="dialog" aria-label={`Open the case file: ${f.title}`}>
                    {f.shot ? <img src={f.shot} alt="" loading="lazy" />
                      : f.paper ? <span class="clip-page" />
                      : <img src={f.shots[0].src} alt="" loading="lazy" />}
                  </button>
                : <span />)}
              {f && (
                <dialog class="file" id={id} aria-labelledby={`${id}-title`}>
                  <div class="file-inner">
                    <header class="file-head">
                      <span>Recognition · Case file</span>
                      <button type="button" class="file-close" data-close>Close the file</button>
                    </header>
                    {f.title !== e.org && <p class="file-org">{e.org}</p>}
                    <h2 id={`${id}-title`}>{f.title}</h2>
                    <ul class="file-awards">
                      {e.roles.map((r) => <li><span>{r.title}</span><span class="meta">{r.years}</span></li>)}
                    </ul>
                    {f.shot && (
                      <figure class="file-print">
                        <img src={f.shot} alt={e.paper ? `A figure from “${e.paper}”` : `Screenshot of ${f.title}`} loading="lazy" />
                        {e.paper && <figcaption>From “{e.paper}”</figcaption>}
                      </figure>
                    )}
                    {f.paper && (
                      <figure class="file-print file-paper" aria-label={`Title page of “${f.paper}”`}>
                        <span class="file-paper-title">{f.paper}</span>
                      </figure>
                    )}
                    {f.summary && <p class="file-summary">{f.summary}</p>}
                    {f.shots.length > 0 && (
                      <div class="file-photos">
                        {f.shots.map((ph) => (
                          <figure class="file-print"><img src={ph.src} alt={ph.caption} loading="lazy" /><figcaption>{ph.caption}</figcaption></figure>
                        ))}
                      </div>
                    )}
                  </div>
                </dialog>
              )}
              <div>
                <h3>
                  {e.peek ? <a class="peek" href={e.peek.src} data-caption={e.peek.caption} data-ratio={e.peek.ratio}>{e.org}</a>
                    : e.href ? <a href={e.href}>{e.org}</a> : e.org}
                </h3>
                {e.note && <p class="note">{e.note}</p>}
                {e.paper && <p class="paper-title">“{e.paper}”</p>}
                {e.roles.map((r) => (
                  <p class="role"><span>{r.title}</span><span class="dots" aria-hidden="true"></span><span class="meta">{r.years}</span></p>
                ))}
              </div>
            </div>
          );
        })}
      </section>
    );
  })}
</Base>

<script>
  // Photo peeks: a link with class "peek" in about.md shows its photo as a taped print, on hover or
  // keyboard focus. A click (or tap) pins it; a second click, Esc or a click elsewhere puts it away.
  // Without the script, the link simply opens the photo.
  const peekCard = document.querySelector<HTMLElement>('.peek-card')!;
  const cardImg = peekCard.querySelector('img')!, cardCap = peekCard.querySelector('figcaption')!;
  // A link to an .mp4 plays as a muted loop, from its data-poster still. With reduced motion it waits
  // on the still, with controls, for the reader to press play.
  const cardVideo = peekCard.querySelector('video')!;
  const peekCalm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let pinned: HTMLAnchorElement | null = null;
  const place = (a: HTMLAnchorElement) => {
    const lines = a.getClientRects(), r = lines[0], last = lines[lines.length - 1]; // the link can wrap
    const w = peekCard.offsetWidth, h = peekCard.offsetHeight;
    const x = Math.max(12, Math.min(innerWidth - w - 12, r.left + r.width / 2 - w / 2));
    // Above the link if it fits, else below it, else as close as the window allows.
    const above = r.top - h - 16, below = last.bottom + 16;
    const y = above >= 12 ? above : below + h <= innerHeight - 12 ? below : Math.max(12, innerHeight - h - 12);
    peekCard.style.left = `${x}px`; peekCard.style.top = `${y}px`;
  };
  const show = (a: HTMLAnchorElement) => {
    const isVideo = /\.mp4$/.test(a.pathname);
    cardImg.hidden = isVideo; cardVideo.hidden = !isVideo;
    if (isVideo) {
      cardVideo.poster = a.dataset.poster ?? '';
      cardVideo.setAttribute('aria-label', a.dataset.caption ?? '');
      cardVideo.controls = peekCalm;
      if (cardVideo.getAttribute('src') !== a.pathname) cardVideo.src = a.pathname;
      if (!peekCalm) cardVideo.play().catch(() => {}); // a blocked autoplay just leaves the still
    } else {
      cardImg.src = a.href; cardImg.alt = a.dataset.caption ?? '';
    }
    cardCap.textContent = a.dataset.caption ?? '';
    // The print takes the photo's shape; a tall photo gets a narrower print.
    const [rw, rh] = (a.dataset.ratio ?? '3 / 2').split('/').map(Number);
    peekCard.style.setProperty('--ratio', `${rw} / ${rh}`);
    peekCard.style.setProperty('--rn', String(rw / rh)); // caps the width so the print fits the window's height
    peekCard.classList.toggle('tall', rh > rw);
    peekCard.hidden = false; place(a);
    requestAnimationFrame(() => peekCard.classList.add('on')); // a frame after showing, so it fades in
  };
  const hide = () => {
    peekCard.classList.remove('on'); peekCard.hidden = true; pinned = null;
    if (!cardVideo.hidden) { cardVideo.pause(); cardVideo.removeAttribute('src'); cardVideo.load(); } // stop and unload
  };
  document.querySelectorAll<HTMLAnchorElement>('a.peek').forEach((a) => {
    a.addEventListener('mouseenter', () => { if (!pinned) show(a); });
    a.addEventListener('mouseleave', () => { if (!pinned) hide(); });
    a.addEventListener('focus', () => show(a));
    a.addEventListener('blur', () => { if (pinned !== a) hide(); });
    a.addEventListener('click', (e) => {
      e.preventDefault();
      if (pinned === a) return hide();
      show(a); pinned = a;
    });
  });
  document.addEventListener('click', (e) => { if (pinned && !(e.target as Element).closest('a.peek, .peek-card')) hide(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !peekCard.hidden) hide(); });
  addEventListener('scroll', () => { if (pinned) place(pinned); else if (!peekCard.hidden) hide(); }, { passive: true });

  // Recognition case files: a print opens its file; the close button, Esc or a click outside closes it.
  document.querySelectorAll<HTMLButtonElement>('[data-file]').forEach((btn) => {
    const file = document.getElementById(btn.dataset.file!) as HTMLDialogElement;
    btn.addEventListener('click', () => file.showModal());
    file.addEventListener('click', (e) => {
      const t = e.target as Element;
      if (t === file || t.closest('[data-close]')) file.close(); // `t === file` is the backdrop
    });
  });

  // Red string, as on an evidence board: from a pin in the photo to a pin by each fact.
  // The ends are measured, so it redraws when the layout changes (side by side, or stacked on phones).
  const card = document.querySelector<HTMLElement>('.card')!;
  const strings = card.querySelector<SVGSVGElement>('.strings')!;
  const drawStrings = () => {
    const c = card.getBoundingClientRect();
    // The print's place comes from its figure, not the print itself: the print moves while it ejects.
    const ev = card.querySelector('.evidence')!.getBoundingClientRect();
    const p = { left: ev.left, right: ev.right, top: ev.top, height: card.querySelector<HTMLElement>('.print')!.offsetHeight };
    const facts = [...card.querySelectorAll('dt')].map((dt) => {
      const r = dt.getBoundingClientRect();
      return { x: r.left - c.left - 10, y: r.top - c.top + r.height / 2 };
    });
    // Side by side: pin the photo's right edge. Stacked: pin its left edge, so the strings miss the name.
    const beside = facts[0].x > p.right - c.left;
    const from = { x: (beside ? p.right - 46 : p.left + 18) - c.left, y: p.top - c.top + p.height * (beside ? 0.42 : 0.8) };
    const string = (q: { x: number; y: number }, i: number) => {
      const sag = 8 + Math.hypot(q.x - from.x, q.y - from.y) * 0.08;
      return `<path pathLength="1" style="--i:${i}" d="M${from.x} ${from.y}Q${(from.x + q.x) / 2} ${(from.y + q.y) / 2 + sag} ${q.x} ${q.y}"/>`;
    };
    const pin = (q: { x: number; y: number }, i: number) =>
      `<g class="${i < 0 ? 'origin' : ''}" style="--i:${i}"><circle class="pin" cx="${q.x}" cy="${q.y}" r="4.5"/><circle class="shine" cx="${q.x - 1.4}" cy="${q.y - 1.4}" r="1.3"/></g>`;
    strings.innerHTML = facts.map(string).join('') + pin(from, -1) + facts.map(pin).join('');
  };
  new ResizeObserver(drawStrings).observe(card);
  document.fonts.ready.then(drawStrings);

  // Booking reveal: the pen letters sit on the real name. Each one is measured: its x from the text,
  // and the shared baseline from an empty inline block. Once they and the strings are drawn, let the
  // paused animations run, then clear the classes and the pen.
  const pen = card.querySelector<SVGSVGElement>('.pen')!;
  const writeName = () => {
    const name = card.querySelector<HTMLElement>('.namesake')!;
    const e = card.querySelector('.evidence')!.getBoundingClientRect();
    const probe = document.createElement('span');
    probe.style.cssText = 'display:inline-block;width:0;height:0';
    name.append(probe);
    const base = probe.getBoundingClientRect().top - e.top;
    probe.remove();
    const range = document.createRange(), walker = document.createTreeWalker(name, NodeFilter.SHOW_TEXT);
    let k = 0, out = '';
    while (walker.nextNode()) {
      const t = walker.currentNode as Text, cs = getComputedStyle(t.parentElement!), size = parseFloat(cs.fontSize);
      [...t.data].forEach((ch, i) => {
        if (!ch.trim()) return;
        range.setStart(t, i); range.setEnd(t, i + 1);
        const x = range.getBoundingClientRect().left - e.left;
        out += `<text x="${x}" y="${base}" font-size="${size}" style="--k:${k++};--len:${size * 6}px;color:${cs.color}">${ch}</text>`;
      });
    }
    pen.innerHTML = out;
  };
  if (card.classList.contains('booking')) {
    document.fonts.ready.then(() => requestAnimationFrame(() => {
      writeName();
      card.classList.add('rolling');
      setTimeout(() => {
        card.classList.remove('booking', 'rolling'); pen.innerHTML = '';
        card.dispatchEvent(new Event('booked')); // the opening paragraph types next (see below)
      }, 3150);
    }));
  }

  // The text types itself out, word by word. The opening paragraph types once the booking reveal ends
  // (the 'booked' event); without a reveal it simply shows. Every heading and paragraph after it types
  // the first time it scrolls into view, but never before the opening paragraph has finished. The words
  // keep their space, so nothing moves. Off for reduced motion.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((entries) => entries.forEach((en) => {
      if (!en.isIntersecting) return;
      en.target.classList.add('typed');
      io.unobserve(en.target);
    }), { rootMargin: '0px 0px -15% 0px' });

    const opening = card.classList.contains('booking') ? '.prose > p:not(h2 ~ p), ' : '';
    document.querySelectorAll<HTMLElement>(`${opening}.prose h2, .prose h2 ~ p`).forEach((block) => {
      // Text, and empty elements such as the Kitchen wordmark, which count as one word.
      const walker = document.createTreeWalker(block, NodeFilter.SHOW_TEXT | NodeFilter.SHOW_ELEMENT);
      const texts: (Text | HTMLElement)[] = [];
      while (walker.nextNode()) {
        const n = walker.currentNode;
        if (n instanceof Text || !n.hasChildNodes()) texts.push(n as Text | HTMLElement);
      }
      let i = 0;
      texts.forEach((t) => {
        if (!(t instanceof Text)) {
          t.classList.add('w');
          return void t.style.setProperty('--i', String(i++));
        }
        const words = document.createDocumentFragment();
        t.data.split(/(\s+)/).forEach((part) => {
          if (!part.trim()) return void words.append(part);
          const w = document.createElement('span');
          w.className = 'w';
          w.style.setProperty('--i', String(i++));
          w.textContent = part;
          words.append(w);
        });
        t.replaceWith(words);
      });
      block.classList.add('typing');
    });

    const intro = opening ? document.querySelector<HTMLElement>('.prose > p.typing') : null;
    const later = document.querySelectorAll<HTMLElement>('.prose h2, .prose h2 ~ p');
    const watch = () => later.forEach((b) => io.observe(b));
    if (!intro) watch();
    else card.addEventListener('booked', () => {
      intro.classList.add('typed');
      setTimeout(watch, intro.querySelectorAll('.w').length * 26); // 26 ms a word, as in the styles
    }, { once: true });
  }
</script>

<style>
  h1 { margin: 48px 0 32px; font-size: clamp(36px, 8vw, 48px); }

  .card { position: relative; display: grid; grid-template-columns: 180px 1fr; gap: 28px; align-items: start; }
  /* Red string and pins (drawn by the script). */
  .strings { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; z-index: 1; }
  .strings :global(path) { fill: none; stroke: var(--accent); stroke-width: 1.4; filter: drop-shadow(0 1.5px 1px rgb(0 0 0 / 0.25)); }
  .strings :global(.pin) { fill: var(--accent); filter: drop-shadow(0 2px 1.5px rgb(0 0 0 / 0.35)); }
  .strings :global(.shine) { fill: rgb(255 255 255 / 0.55); }

  /* The portrait as evidence: a print with a paper border, tilted and taped to the board,
     with the name below in the B.C.A. red and circled in red pen. */
  .evidence { position: relative; margin: 14px 0 0; width: 180px; }
  .print {
    position: relative; padding: 8px; background: #f4efe2; transform: rotate(-2.5deg);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.18), 0 12px 22px -12px rgb(0 0 0 / 0.55);
  }
  /* Clear tape, a little crooked, with torn ends. */
  .print::before {
    content: ''; position: absolute; z-index: 1; top: -12px; left: 50%; width: 76px; height: 26px;
    transform: translateX(-50%) rotate(4deg);
    background: linear-gradient(rgb(255 255 255 / 0.35), rgb(255 255 255 / 0) 60%), rgb(205 194 160 / 0.62);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.18), inset 0 0 0 1px rgb(255 255 255 / 0.25);
    clip-path: polygon(0 6%, 4% 0, 7% 8%, 11% 2%, 89% 0, 93% 7%, 97% 1%, 100% 8%, 100% 94%, 96% 100%, 92% 93%, 88% 100%, 12% 98%, 8% 92%, 4% 100%, 0 93%);
  }
  .print img, .photo { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; filter: sepia(0.12) saturate(0.92); }
  .photo { background: var(--paper); }
  /* The name set like the B.C.A. mark: the initials in ink, the rest quieter, and the mark's red dots. */
  .namesake { width: max-content; margin: 22px auto 0; font: 17px/1 var(--deco); letter-spacing: 0.02em; color: var(--muted); }
  .namesake b { font-weight: 400; font-size: 1.5em; color: var(--ink); }
  .namesake i { font-style: normal; font-size: 1.5em; color: var(--accent); }
  dl { margin: 0; display: grid; grid-template-columns: max-content 1fr; gap: 10px 16px; align-items: baseline; }
  dd { margin: 0; }
  @media (max-width: 480px) { .card { grid-template-columns: 1fr; } .evidence { margin-inline: auto; } }

  /* Booking: the portrait comes out of a Polaroid camera. The blank print slides out of a slot at its top
     edge (0 to 0.7 s), tilts as it is laid on the board, and the tape presses it down (1.1 s). The picture
     comes up in black and white while it ejects, holds, and the color comes in once it is taped (1.2 s
     to 1.9 s). The whole reveal takes about 3 seconds. Then the pins go in, the red strings run out to each fact, and the name is written in pen,
     letter by letter, before the ink fills in. The inline script adds .booking, which holds every
     animation on its first frame; the module script draws the strings and the pen letters, then adds
     .rolling to play them. Reduced motion never gets .booking. */
  .booking:not(.rolling) :global(*), .booking:not(.rolling) .print::before { animation-play-state: paused !important; }
  /* The slot: the print moves down by the same share that its clip opens, so its visible top edge stays
     put. Linear, like a camera's motor. */
  .booking .print { animation: eject 900ms linear backwards; }
  @keyframes eject {
    0% { transform: translateY(-100%) rotate(0deg); clip-path: inset(100% -40px -40px -40px); }
    75% { transform: translateY(0) rotate(0deg); clip-path: inset(0 -40px -40px -40px); animation-timing-function: ease-out; }
    100% { transform: translateY(0) rotate(-2.5deg); clip-path: inset(0 -40px -40px -40px); }
  }
  .booking .print::before { animation: tape 240ms ease-in 1100ms backwards; }
  @keyframes tape { from { opacity: 0; transform: translateX(-50%) translateY(-12px) rotate(9deg) scale(1.15); } }
  /* Every keyframe lists the same filters in the same order, so the browser can blend between them. */
  .booking .print img { animation: develop 1900ms ease-out backwards; }
  @keyframes develop {
    0%, 15% { filter: grayscale(1) sepia(0) saturate(1) contrast(0.04) brightness(1.7); }
    50%, 62% { filter: grayscale(1) sepia(0) saturate(1) contrast(1.15) brightness(0.95); }
    100% { filter: grayscale(0) sepia(0.12) saturate(0.92) contrast(1) brightness(1); }
  }
  .booking .strings :global(path) { stroke-dasharray: 1; animation: draw 330ms cubic-bezier(0.3, 0.7, 0.3, 1) calc(1450ms + var(--i) * 120ms) backwards; }
  @keyframes draw { from { stroke-dashoffset: 1; } }
  .booking .strings :global(g) { transform-box: fill-box; transform-origin: center; animation: pin-in 220ms ease-in calc(1750ms + var(--i) * 120ms) backwards; }
  .booking .strings :global(g.origin) { animation-delay: 1400ms; }
  @keyframes pin-in { from { opacity: 0; transform: scale(2.2); } 70% { transform: scale(0.9); } }
  .booking dl > * { animation: fact-in 260ms ease-out calc(1750ms + var(--i) * 120ms) backwards; }
  @keyframes fact-in { from { opacity: 0; transform: translateX(-6px); } }
  /* The signature: each letter's outline is traced in pen (45 ms apart, from 1.8 s), then the name's
     ink fades in as the pen lines fade out. */
  .pen { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; font-family: var(--deco); }
  .pen :global(text) {
    fill: none; stroke: currentColor; stroke-width: 0.8; stroke-linejoin: round; stroke-dasharray: var(--len);
    animation: trace 280ms ease-in-out calc(1800ms + var(--k) * 45ms) backwards;
  }
  @keyframes trace { from { stroke-dashoffset: var(--len); } }
  .booking .pen { animation: fade 300ms 2800ms forwards; }
  @keyframes fade { to { opacity: 0; } }
  .booking .namesake { animation: ink 300ms ease 2750ms backwards; }
  @keyframes ink { from { opacity: 0; } }

  .prose { margin-top: 40px; font-size: 18px; }
  .prose :global(h2) { font-size: 24px; margin-top: 40px; }
  /* A line that shows a photo: a dotted red underline marks it. */
  .prose :global(a.peek), h3 a.peek { text-decoration: underline dotted var(--accent); text-decoration-thickness: 1.5px; text-underline-offset: 4px; }
  .prose :global(a.peek:hover), .prose :global(a.peek:focus-visible), h3 a.peek:is(:hover, :focus-visible) { color: var(--accent); }
  /* The photo, as a print taped to the page with clear tape, like the portrait. */
  .peek-card {
    position: fixed; z-index: 60; width: min(320px, calc(100vw - 24px)); margin: 0; padding: 8px 8px 10px;
    background: #f4efe2; pointer-events: none; opacity: 0; transform: rotate(-2deg) translateY(6px) scale(0.97);
    transition: opacity 0.2s, transform 0.25s cubic-bezier(0.2, 0.9, 0.2, 1);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.18), 0 16px 30px -12px rgb(0 0 0 / 0.55);
  }
  .peek-card.on { opacity: 1; transform: rotate(-2deg); }
  .peek-card::before {
    content: ''; position: absolute; z-index: 1; top: -10px; left: 50%; width: 70px; height: 22px;
    transform: translateX(-50%) rotate(3deg);
    background: linear-gradient(rgb(255 255 255 / 0.35), rgb(255 255 255 / 0) 60%), rgb(205 194 160 / 0.62);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.18);
    clip-path: polygon(0 6%, 4% 0, 7% 8%, 11% 2%, 89% 0, 93% 7%, 97% 1%, 100% 8%, 100% 94%, 96% 100%, 92% 93%, 88% 100%, 12% 98%, 8% 92%, 4% 100%, 0 93%);

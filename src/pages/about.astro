---
import Base from '../layouts/Base.astro';
import { Content } from '../about.md';
import { site, about, timeline } from '../site';
---
<Base title="About">
  <h1>About</h1>

  <div class="card">
    <figure class="evidence">
      <div class="print">
        {about.photo ? <img src={about.photo} alt={`Portrait of ${site.name}`} /> : <div class="photo" />}
      </div>
      <figcaption class="suspect">
        {site.name}
        <svg viewBox="0 0 200 60" preserveAspectRatio="none" aria-hidden="true">
          <path d="M34 13C78 2 162 4 188 22c16 12-8 30-78 33C50 58 8 48 10 32 12 18 52 7 124 9" />
        </svg>
      </figcaption>
    </figure>
    <dl>
      {about.facts.map((f) => (<><dt class="label">{f.label}</dt><dd>{f.value}</dd></>))}
      <dt class="label">Contact</dt>
      <dd>
        {[{ label: 'Email', href: `mailto:${site.email}` }, ...site.socials.filter((s) => s.href)].map((s, i) => (
          <>{i > 0 && ' · '}<a href={s.href}>{s.label}</a></>
        ))}
      </dd>
    </dl>
    <svg class="strings" aria-hidden="true"></svg>
  </div>

  <div class="prose"><Content /></div>

  {timeline.map((t) => (
    <section>
      <h2 class="label">{t.heading}</h2>
      {t.entries.map((e) => (
        <div class="entry">
          <h3>{e.href ? <a href={e.href}>{e.org}</a> : e.org}</h3>
          {e.note && <p class="note">{e.note}</p>}
          {e.roles.map((r) => (
            <p class="role"><span>{r.title}</span><span class="dots" aria-hidden="true"></span><span class="meta">{r.years}</span></p>
          ))}
        </div>
      ))}
    </section>
  ))}
</Base>

<script>
  // Red string, as on an evidence board: from a pin in the photo to a pin by each fact.
  // The ends are measured, so it redraws when the layout changes (side by side, or stacked on phones).
  const card = document.querySelector<HTMLElement>('.card')!;
  const strings = card.querySelector<SVGSVGElement>('.strings')!;
  const drawStrings = () => {
    const c = card.getBoundingClientRect();
    const p = card.querySelector('.print')!.getBoundingClientRect();
    const facts = [...card.querySelectorAll('dt')].map((dt) => {
      const r = dt.getBoundingClientRect();
      return { x: r.left - c.left - 10, y: r.top - c.top + r.height / 2 };
    });
    // Side by side: pin the photo's right edge. Stacked: pin its left edge, so the strings miss the name.
    const beside = facts[0].x > p.right - c.left;
    const from = { x: (beside ? p.right - 46 : p.left + 18) - c.left, y: p.top - c.top + p.height * (beside ? 0.42 : 0.8) };
    const string = (q: { x: number; y: number }) => {
      const sag = 8 + Math.hypot(q.x - from.x, q.y - from.y) * 0.08;
      return `<path d="M${from.x} ${from.y}Q${(from.x + q.x) / 2} ${(from.y + q.y) / 2 + sag} ${q.x} ${q.y}"/>`;
    };
    const pin = (q: { x: number; y: number }) =>
      `<circle class="pin" cx="${q.x}" cy="${q.y}" r="4.5"/><circle class="shine" cx="${q.x - 1.4}" cy="${q.y - 1.4}" r="1.3"/>`;
    strings.innerHTML = facts.map(string).join('') + [from, ...facts].map(pin).join('');
  };
  new ResizeObserver(drawStrings).observe(card);
  document.fonts.ready.then(drawStrings);

  // Things I do and Outside of code: each heading and paragraph types itself out, word by word,
  // the first time it scrolls into view. The words keep their space, so nothing moves. Off for
  // reduced motion.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((entries) => entries.forEach((en) => {
      if (!en.isIntersecting) return;
      en.target.classList.add('typed');
      io.unobserve(en.target);
    }), { rootMargin: '0px 0px -15% 0px' });

    document.querySelectorAll<HTMLElement>('.prose h2, .prose h2 ~ p').forEach((block) => {
      const walker = document.createTreeWalker(block, NodeFilter.SHOW_TEXT);
      const texts: Text[] = [];
      while (walker.nextNode()) texts.push(walker.currentNode as Text);
      let i = 0;
      texts.forEach((t) => {
        const words = document.createDocumentFragment();
        t.data.split(/(\s+)/).forEach((part) => {
          if (!part.trim()) return void words.append(part);
          const w = document.createElement('span');
          w.className = 'w';
          w.style.setProperty('--i', String(i++));
          w.textContent = part;
          words.append(w);
        });
        t.replaceWith(words);
      });
      block.classList.add('typing');
      io.observe(block);
    });
  }
</script>

<style>
  h1 { margin: 48px 0 32px; font-size: clamp(36px, 8vw, 48px); }

  .card { position: relative; display: grid; grid-template-columns: 180px 1fr; gap: 28px; align-items: start; }
  /* Red string and pins (drawn by the script). */
  .strings { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; z-index: 1; }
  .strings :global(path) { fill: none; stroke: var(--accent); stroke-width: 1.4; filter: drop-shadow(0 1.5px 1px rgb(0 0 0 / 0.25)); }
  .strings :global(.pin) { fill: var(--accent); filter: drop-shadow(0 2px 1.5px rgb(0 0 0 / 0.35)); }
  .strings :global(.shine) { fill: rgb(255 255 255 / 0.55); }

  /* The portrait as evidence: a print with a paper border, tilted and taped to the board,
     with the name below in the B.C.A. red and circled in red pen. */
  .evidence { margin: 14px 0 0; width: 180px; }
  .print {
    position: relative; padding: 8px; background: #f4efe2; transform: rotate(-2.5deg);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.18), 0 12px 22px -12px rgb(0 0 0 / 0.55);
  }
  /* Clear tape, a little crooked, with torn ends. */
  .print::before {
    content: ''; position: absolute; z-index: 1; top: -12px; left: 50%; width: 76px; height: 26px;
    transform: translateX(-50%) rotate(4deg);
    background: linear-gradient(rgb(255 255 255 / 0.35), rgb(255 255 255 / 0) 60%), rgb(205 194 160 / 0.62);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.18), inset 0 0 0 1px rgb(255 255 255 / 0.25);
    clip-path: polygon(0 6%, 4% 0, 7% 8%, 11% 2%, 89% 0, 93% 7%, 97% 1%, 100% 8%, 100% 94%, 96% 100%, 92% 93%, 88% 100%, 12% 98%, 8% 92%, 4% 100%, 0 93%);
  }
  .print img, .photo { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; filter: sepia(0.12) saturate(0.92); }
  .photo { background: var(--paper); }
  .suspect {
    position: relative; width: max-content; margin: 22px auto 0; padding: 4px 10px;
    font: 18px/1.2 var(--deco); letter-spacing: 0.02em; color: var(--accent); transform: rotate(-1.5deg);
  }
  .suspect svg { position: absolute; top: -10px; left: -18px; width: calc(100% + 36px); height: calc(100% + 20px); overflow: visible; }
  .suspect path { fill: none; stroke: var(--accent); stroke-width: 1.6; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  dl { margin: 0; display: grid; grid-template-columns: max-content 1fr; gap: 10px 16px; align-items: baseline; }
  dd { margin: 0; }
  @media (max-width: 480px) { .card { grid-template-columns: 1fr; } .evidence { margin-inline: auto; } }

  .prose { margin-top: 40px; font-size: 18px; }
  .prose :global(h2) { font-size: 24px; margin-top: 40px; }
  /* Typing on scroll (see the script): one word every 35 ms. */
  .prose :global(.typing .w) { opacity: 0; }
  .prose :global(.typed .w) { opacity: 1; transition: opacity 0.08s calc(var(--i) * 35ms); }

  section { margin-top: 56px; }
  section > .label { border-bottom: 1px solid var(--line); padding-bottom: 8px; margin-bottom: 8px; }
  .entry { padding: 12px 0; }
  .entry + .entry { border-top: 1px dashed var(--line); }
  h3 { font-size: 19px; margin: 0 0 4px; }
  h3 a { text-decoration: none; }
  .note { margin: -2px 0 6px; font: italic 15px var(--serif); color: var(--muted); }
  .role { display: flex; align-items: baseline; gap: 8px; margin: 2px 0; color: var(--muted); }
  .role .dots { flex: 1; border-bottom: 1px dotted var(--muted); opacity: 0.5; transform: translateY(-4px); }
  .role .meta { white-space: nowrap; }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { site, projects, library, photos } from '../site';

const posts = (await getCollection('writing', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
const letter = (i: number) => String.fromCharCode(65 + i); // Exhibit A, B, C...
---
<Base>
  <section class="intro">
    <h1>Hi, I'm Bill.</h1>
    <p class="tagline">
      <em>currently</em> <span id="doing" class="doing" aria-hidden="true" data-words={JSON.stringify(site.doing)}>{site.doing[0]}</span><span class="sr">{site.doing[0]}</span>.
    </p>
    <p class="meta">{site.role} · {site.location}</p>
    <p>
      I build AI applications end to end, from the model to the API to the interface people actually use.
      Lately that means speech coaching, clinical triage, civic tech, and measuring where the energy in a
      transformer goes.
    </p>
    <p>
      Get to know <a href="/about/">more about me</a>, read my <a href="#writing">writing</a>, look through the <a href="#exhibits">evidence</a>,
      see what's on my <a href="#library">shelf</a>, or say hi at <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
  </section>

  <section id="writing">
    <div class="head"><h2 class="label">Writing</h2><a class="meta" href="/writing/">View all</a></div>
    <PostList posts={posts} />
  </section>

  <section id="exhibits">
    <div class="head"><h2 class="label">Exhibits</h2></div>
    <div class="exhibits">
      {projects.map((p, i) => {
        const Tag = p.href ? 'a' : 'div';
        return (
          <Tag class="exhibit" href={p.href}>
            <div class="shot">
              {p.image
                ? <img src={p.image} alt={`Screenshot of ${p.title}`} loading="lazy" />
                : <span class="meta">screenshot pending</span>}
            </div>
            <div class="tag">
              <p class="label">Exhibit {letter(i)} · {p.year}</p>
              <h3>{p.title}</h3>
              <p class="kind">{p.kind}</p>
              <p class="blurb">{p.blurb}</p>
              <p class="meta">{p.tools.join(' · ')}</p>
            </div>
          </Tag>
        );
      })}
    </div>
  </section>

  <section id="library">
    <div class="head"><h2 class="label">Library</h2></div>
    <ul class="shelf">
      {library.map((b) => (
        <li class={b.kind} style={`--spine:${b.color}`} title={`${b.title} by ${b.author} (${b.kind})`}>
          <span>{b.title}</span>
        </li>
      ))}
    </ul>
    <p class="meta legend">Books, manga and manhwa. Hover a spine for details.</p>
  </section>

  <section id="photos">
    <div class="head"><h2 class="label">Photos</h2></div>
    <div class="photos">
      {photos.map((ph) => (
        <figure>
          {ph.image ? <img src={ph.image} alt={ph.caption} loading="lazy" /> : <div class="ph" />}
          <figcaption class="meta">{ph.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>
</Base>

<script>
  // Every few seconds, pick another random phrase and scramble into it.
  const el = document.getElementById('doing')!;
  const words: string[] = JSON.parse(el.dataset.words!);
  const glyphs = 'abcdefghijklmnopqrstuvwxyz_<>/{}#*';
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let current = words[0];

  const scramble = (to: string) => {
    if (calm) return void (el.textContent = to);
    const start = performance.now();
    const frame = (now: number) => {
      const done = Math.min((now - start) / 600, 1); // 600 ms
      const fixed = Math.floor(done * to.length);
      el.textContent = to.slice(0, fixed) + [...to.slice(fixed)]
        .map((c) => (c === ' ' ? ' ' : glyphs[Math.floor(Math.random() * glyphs.length)]))
        .join('');
      if (done < 1) requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  };

  setInterval(() => {
    if (document.hidden) return;
    let next = current;
    while (next === current) next = words[Math.floor(Math.random() * words.length)];
    current = next;
    scramble(next);
  }, 3500);
</script>

<style>
  section { margin-top: 72px; }
  .intro { margin-top: 48px; }
  h1 { font-size: clamp(36px, 8vw, 48px); margin: 0; }
  .tagline { font: 20px var(--serif); margin: 4px 0 8px; color: var(--muted); }
  .intro .meta { margin: 0 0 24px; }

  .head {
    display: flex; justify-content: space-between; align-items: baseline;
    border-bottom: 1px solid var(--line); padding-bottom: 8px; margin-bottom: 16px;
  }
  .head a { text-decoration: none; }

  /* Evidence-tag cards: screenshot, then a paper tag with a punched hole. */
  .exhibits { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 32px 24px; }
  .exhibit { display: block; text-decoration: none; color: inherit; }
  .shot {
    aspect-ratio: 16 / 10; border: 1px solid var(--line); border-radius: 4px; overflow: hidden;
    display: grid; place-items: center;
    background: repeating-linear-gradient(-45deg, transparent 0 8px, var(--line) 8px 9px);
  }
  .shot img { width: 100%; height: 100%; object-fit: cover; }
  .tag {
    position: relative; margin: -14px 12px 0; padding: 14px 16px 12px 32px;
    background: var(--paper); border-radius: 2px 6px 6px 2px; transform: rotate(-0.6deg);
    box-shadow: 0 1px 0 var(--line);
    transition: transform 0.2s ease;
  }
  .tag::before {
    content: ''; position: absolute; left: 12px; top: 18px;
    width: 8px; height: 8px; border-radius: 50%; background: var(--bg); box-shadow: inset 0 0 0 1px var(--line);
  }
  a.exhibit:hover .tag { transform: rotate(0deg) translateY(-2px); }
  a.exhibit:hover h3 { color: var(--accent); }
  .tag .label { color: var(--accent); }
  .tag h3 { font-size: 20px; margin: 4px 0 0; }
  .kind { margin: 0; font: italic 15px var(--serif); color: var(--muted); }
  .blurb { font-size: 15px; margin: 8px 0; }
  .tag .meta { margin: 0; font-size: 12px; }
  @media (prefers-reduced-motion: reduce) { .tag { transition: none; } }

  .shelf { list-style: none; margin: 0; padding: 0 0 0 4px; display: flex; gap: 6px; align-items: flex-end; border-bottom: 6px solid var(--line); }
  .shelf li {
    width: 44px; height: 180px; background: var(--spine); border-radius: 2px;
    display: flex; align-items: center; justify-content: center; overflow: hidden;
    color: #f7f5ef;
  }
  .shelf li.book:nth-child(odd) { height: 168px; }
  /* Manga and manhwa: short, thin tankobon volumes with a band at the top. */
  .shelf li.manga, .shelf li.manhwa {
    width: 30px; height: 126px; color: #17160f;
    background: linear-gradient(#17160f 0 10px, var(--spine) 10px);
  }
  .shelf li.manhwa { color: #f7f5ef; background: linear-gradient(var(--accent) 0 10px, var(--spine) 10px); }
  .shelf span { writing-mode: vertical-rl; transform: rotate(180deg); font: 500 13px var(--sans); white-space: nowrap; }
  .shelf .manga span, .shelf .manhwa span { font-size: 11px; }
  .legend { margin: 8px 0 0; font-size: 12px; }

  .doing { font: 0.85em var(--mono); color: var(--accent); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .photos { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 16px; }
  figure { margin: 0; }
  figure img, .ph { aspect-ratio: 4 / 5; width: 100%; object-fit: cover; border-radius: 4px; }
  .ph { background: var(--paper); }
  figcaption { margin-top: 6px; }
</style>

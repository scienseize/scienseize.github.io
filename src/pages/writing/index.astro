---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';

const posts = (await getCollection('writing', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))];
---
<Base title="Writing" description="Essays and notes by Bill C. Alcantara, an AI engineer in Manila.">
  <h1>Writing</h1>
  {posts.length === 0 && <p class="meta">No posts yet. The first case notes are on their way.</p>}
  {years.map((y) => (
    <section>
      <h2 class="label">{y}</h2>
      <PostList posts={posts.filter((p) => p.data.date.getFullYear() === y)} />
    </section>
  ))}
</Base>

<style>
  h1 { margin: 48px 0 0; font-size: 40px; }
  section { margin-top: 40px; }
  .label { border-bottom: 1px solid var(--line); padding-bottom: 8px; margin-bottom: 8px; }
</style>

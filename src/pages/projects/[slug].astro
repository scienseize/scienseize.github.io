---
// A shareable link for each project: the Projects page, with that project's sheet open.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Home from '../../components/Home.astro';

export async function getStaticPaths() {
  return (await getCollection('projects')).map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
---
<Base title={p.data.title} description={p.data.blurb}><Home section="projects" /></Base>
